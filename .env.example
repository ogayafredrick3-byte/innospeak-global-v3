# Browser-safe Supabase configuration. Use only the project URL and anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Configure function secrets in the Supabase project (not in VITE_* variables).
# PUBLIC_SITE_URL=https://your-production-domain.example
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase Functions.
# Payment and provider secrets must remain server-side.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=
# MPESA_ENV=sandbox  # use sandbox for testing; production for live payments
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.paypal.com
# RESEND_API_KEY=
# GEMINI_API_KEY=
